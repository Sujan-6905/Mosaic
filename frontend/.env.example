NEXT_PUBLIC_API_URL=http://localhost:5000
# The public address of this site: canonical links, the sitemap, social cards and embed links use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: where /mcp, OAuth and oEmbed are proxied when the server reaches the backend by another address.
# BACKEND_URL=http://backend:5000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
# Server only, never NEXT_PUBLIC_: must equal the backend's FRONTEND_SERVER_KEY.
FRONTEND_SERVER_KEY=replace-with-the-backend-value

# Optional: the Google and GitHub sign-in buttons only render when these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
