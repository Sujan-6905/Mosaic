# Only for running locally over stdio; the hosted server at /mcp needs none of this.

# The Mosaic backend (REST and Socket.io) and the app address links should point at.
MOSAIC_API_URL=http://localhost:5000
MOSAIC_APP_URL=http://localhost:3000

# A personal access token from Profile > Personal access tokens...
MOSAIC_TOKEN=

# ...or an account to sign in as, kept renewed while the server runs.
MOSAIC_USERNAME=
MOSAIC_PASSWORD=
