# Copy to backend/.env. Only the first block is required; every optional setting below turns a feature on.

# Required: Couchbase Capella and token signing
CB_CONNECTION_STRING=couchbases://cb.xxxxxxxx.cloud.couchbase.com
CB_USERNAME=your_capella_database_access_username
CB_PASSWORD=your_capella_database_access_password
CB_BUCKET_NAME=whiteboard
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret

PORT=5000

# The frontend. PUBLIC_APP_URL is its public address (hosted MCP, OAuth metadata, embeds and links name it)
# and the default CORS origin; FRONTEND_SERVER_KEY must equal the frontend's own value.
PUBLIC_APP_URL=http://localhost:3000
FRONTEND_SERVER_KEY=replace_with_a_long_random_secret
# CORS_ORIGINS=http://localhost:3000,https://mosaic.example.com
# Proxies in front of this server; defaults to 1 in production and 0 locally.
# TRUST_PROXY=1
# Sign-ups and password checks allowed per address per minute.
# AUTH_RATE_LIMIT_PER_MINUTE=10

# AI assistant. Unset hides it. The models are optional overrides of each role's default.
GROQ_API_KEY=
# AI_MODEL_REASONING=qwen/qwen3.8-27b
# AI_MODEL_FALLBACK=openai/gpt-oss-20b,openai/gpt-oss-120b
# AI_MODEL_PROMPT_GUARD=meta-llama/llama-prompt-guard-2-86m
# AI_MODEL_STYLIST=openai/gpt-oss-20b
# A slower provider may need longer: one model call, and a whole turn (milliseconds).
# AI_CALL_TIMEOUT_MS=20000
# AI_TURN_DEADLINE_MS=45000

# Raises GitHub's limit of 60 requests an hour when mapping a public repository. Needs no scopes.
# GITHUB_TOKEN=

# Shares live rooms, Socket.io broadcasts and rate limits across instances. Unset keeps them in memory.
# REDIS_URL=redis://localhost:6379

# Image uploads, signed here and sent straight from the browser to Cloudinary. All three or none.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Browser notifications for mentions. Generate once with `npx web-push generate-vapid-keys` and keep the pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Slack link unfurling: point the app's Events URL at /api/slack/events.
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=

# Operations: alerts are posted to any JSON webhook, and /admin/dashboard?token=... opens with this token.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# DASHBOARD_TOKEN=replace_with_a_long_random_secret
# LOG_LEVEL=info

# Limits and history
# MAX_BOARD_COLLABORATORS=10
# EMBED_LIVE_VIEWER_CAP=1000
# SNAPSHOT_OP_INTERVAL=200
# SNAPSHOT_TIME_INTERVAL_MS=600000
# HISTORY_RETENTION_DAYS=30
# HISTORY_RETENTION_MIN_SNAPSHOTS=5
# PERSONAL_TOKENS_DISABLED=false

# Only for benchmark/runStorageBenchmark.js, which compares MongoDB with Couchbase.
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
# Only for benchmark/runModelBenchmark.js; each is optional and adds that provider's models.
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
